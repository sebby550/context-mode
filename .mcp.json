{
  "mcpServers": {
    "context-mode": {
      "command": "node",
      "args": ["/home/user/context-mode/start.mjs"]
    },
    "gdrive": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gdrive"],
      "env": {
        "GDRIVE_OAUTH_PATH": "/root/.config/gdrive-mcp/gcp-oauth.keys.json",
        "GDRIVE_CREDENTIALS_PATH": "/root/.config/gdrive-mcp/credentials.json"
      }
    }
  }
}
